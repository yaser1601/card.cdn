{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/images/:path*", "destination": "/api/asset?b=game-assets&p=images/:path*" },
    { "source": "/voice/:path*",  "destination": "/api/asset?b=game-assets&p=voice/:path*" },
    { "source": "/custom/:path*", "destination": "/api/asset?b=cards&p=:path*" }
  ]
}
